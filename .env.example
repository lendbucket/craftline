# Craftline Brands environment variables
# Copy this file to .env.local and fill in the values you have.
# NEVER commit real values. .env* is gitignored except this file.

# Public site URL, used for canonical links, sitemap, and schema.
NEXT_PUBLIC_SITE_URL=https://craftlinebrands.com

# Public contact address, rendered on the contact page and in Organization
# schema. INTENTIONALLY BLANK: no Craftline mailbox exists yet, and the site
# renders no email at all while this is unset rather than shipping an invented
# one. Fill it in the same commit that the mailbox goes live, and update the
# contact section of the privacy policy in that same commit.
#
# This is NOT the same setting as INQUIRY_TO_EMAIL below. This one is published
# to readers; that one is where internal notifications land.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# SUPABASE. Inquiry storage.
#
# Writes go to the existing Wattsmith project, tables
# craftline_franchise_inquiries and craftline_contact_messages. RLS is on with
# zero policies, so the service role is the only way in.
#
# NEITHER OF THESE IS PREFIXED NEXT_PUBLIC_, AND NEITHER EVER MAY BE. The prefix
# is what tells Next.js to inline a value into the browser bundle. There is no
# anon key here because the browser never talks to Supabase on this site: every
# write goes through a server action.
#
# The service role key bypasses RLS and can read and write every row in that
# project, including the Wattsmith lead, applicant, offer, and onboarding
# tables. Treat it accordingly.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# RESEND. Notification email on each stored submission.
#
# A failed send does not fail the submission: the row is already stored and the
# submitter is told the truth. Failures are logged server side.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Interim internal destination until a Craftline mailbox exists. Overrides the
# committed default in src/config/notifications.ts.
INQUIRY_TO_EMAIL=robert@wattsmithelectric.com
# Must be a verified sender domain in the Resend account. No default: an unset
# sender fails loudly at send time rather than trying an unverified address.
INQUIRY_FROM_EMAIL=
# Only set this to point notifications at a local stand-in. Leave unset in every
# real environment so the default Resend endpoint is used.
# RESEND_API_URL=
