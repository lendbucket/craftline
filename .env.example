# Craftline Brands environment variables
# Copy this file to .env.local and fill in the values you have.
# Everything is optional for local development.

# Public site URL, used for canonical links, sitemap, and schema.
NEXT_PUBLIC_SITE_URL=https://craftlinebrands.com

# Public contact address, rendered on the contact page and in Organization
# schema. INTENTIONALLY BLANK: no Craftline mailbox exists yet, and the site
# renders no email at all while this is unset rather than shipping an invented
# one. Fill it in the same commit that the mailbox goes live.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Not wired yet. These land with the franchise inquiry and contact forms.
# Listed here so the deploy target can be configured ahead of the code.
# ---------------------------------------------------------------------------

# Resend (email notification on new inquiries).
RESEND_API_KEY=
# Interim destination until a Craftline mailbox exists.
INQUIRY_TO_EMAIL=robert@wattsmithelectric.com
# Must be a verified sender domain in the Resend account.
INQUIRY_FROM_EMAIL=

# Supabase (inquiry storage). RLS enabled, zero policies, service role only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS and can read and write every row in the
# project. Never expose this to the browser and never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
